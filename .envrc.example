use_nvm() {
  local node_version=$1
  nvm_sh=$([ -s "$NVM_DIR/nvm.sh" ] && echo "$NVM_DIR/nvm.sh")
  if [ -n "$nvm_sh" ]; then
    source "$nvm_sh"
    nvm use "$node_version"
  fi
}

use_nvm 24

# Dev server defaults — separate from installed app (port 8080, ~/.battleship/data)
export SERVER_PORT=8082
export DB_URL="jdbc:h2:file:${HOME}/.battleship/dev-data;AUTO_SERVER=TRUE"

# Backend (signaling-server) — additional overrides as needed
# export SERVER_ADDRESS=localhost
# export ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://ryandur.github.io
# export LOG_LEVEL=INFO
